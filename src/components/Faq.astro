---
// Accordion FAQ, adapted from the network's Faq.astro for this build's
// must-fix #1 (2026-09-13 pre-build SEO audit): design-export specifies a
// real collapsing accordion (one item open by default, click to toggle) on
// every page. Built with native <details>/<summary> rather than a client-only
// conditional render, so every answer ships in the server-rendered HTML
// regardless of open/closed state, no JS required for the collapse itself.
// JSON-LD contract (faqSchema) is unchanged from the network original.
// The accordion chevron styling here is scoped to this component (Astro
// <style>) rather than added to template.css or theme.css, since it is not
// yet promoted to the canonical network Faq.astro; flagged in this build's
// receipt as a local deviation, same pattern as the Service/BreadcrumbList
// schema addition in lib/site.js.
import { faqSchema } from '../lib/site.js';
interface FaqItem { q: string; a: string; }
interface Props { items: FaqItem[]; }
const { items } = Astro.props as Props;
const schema = faqSchema(items);
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<div class="faq">
  {items.map((item, i) => (
    <details class="faq-item" open={i === 0}>
      <summary><span class="faq-q">{item.q}</span><span class="faq-sign" aria-hidden="true"></span></summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>
<style>
  .faq-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    cursor: pointer; list-style: none; font-family: var(--font-display);
    font-weight: 700; font-size: 1.05rem; color: var(--brand-deep);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-q { flex: 1; }
  .faq-sign {
    flex: none; width: 1.4rem; height: 1.4rem; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--brand-signal); font-weight: 800; font-size: 1.2rem; line-height: 1;
  }
  .faq-sign::before { content: "+"; }
  details[open] .faq-sign::before { content: "\2212"; }
  .faq-item p { margin-top: .6rem; }
</style>
